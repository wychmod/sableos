<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sableos</groupId>
    <artifactId>sableos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sableos-cli</artifactId>
  <name>sableos-cli</name>
  <description>命令行入口：Picocli 主入口、子命令、ConfigLoader</description>

  <dependencies>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-core</artifactId>
    </dependency>
    <!-- 18 节：cli 升为聚合入口——SableOsRuntime 装配根需引用持久化实现与 chat 交互通道。
         不依赖 sableos-boot（boot→cli 单向，无环）；provider/memory/tool 等 bean 运行期由组件扫描从 boot 的 @Configuration 收编。 -->
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-channel-cli</artifactId>
    </dependency>
    <!-- 008：白名单首次导入与装配需要 WhitelistSandbox.refresh / DefaultSandboxWhitelistAdmin。
         tool 只依赖 core，加这条边不成环（cli→tool→core）；对齐 oryxos-cli 依赖 oryxos-tool 的做法。 -->
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- 重命令（chat/serve/gateway）自启动 Spring + JPA；轻命令 session list 裸 JDBC 直读（运行期驱动） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <!-- 轻命令 provider list 读 classpath 的 application.yaml（sableos.providers），零 Spring -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- 可执行 fat JAR 由 sableos-boot 产出（mainClass=com.sableos.cli.SableOsCli）；cli 是库，不再自行 repackage。 -->
    </plugins>
  </build>
</project>
