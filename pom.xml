<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.sableos</groupId>
  <artifactId>sableos-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SableOS</name>
  <description>企业能完全掌控的、Java 原生的、私有可审计的 Agent OS（Agent Harness OS）</description>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <modules>
    <module>sableos-core</module>
    <module>sableos-provider</module>
    <module>sableos-memory</module>
    <module>sableos-tool</module>
    <module>sableos-channel-cli</module>
    <module>sableos-web</module>
    <module>sableos-storage</module>
    <module>sableos-cli</module>
    <module>sableos-boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>

    <!-- Spring AI 1.1.x 线（Boot 3.5 兼容；2.x 需要 Boot 4）。只用于 Provider 抽象、
         协议转换与 @Tool schema 生成，禁用其自动 tool 执行（宪章原则 III）。 -->
    <spring-ai.version>1.1.8</spring-ai.version>
    <!-- Spring AI Alibaba 1.1.2.x 线，与 Spring AI 1.1.x 同期；security-fix 为 CVE 修补版 -->
    <spring-ai-alibaba.version>1.1.2.4-security-fix</spring-ai-alibaba.version>
    <picocli.version>4.7.7</picocli.version>

    <!-- SQLite 默认零配置档；PostgreSQL 为部署选项（双轨迁移 db/migration/{vendor}）。
         覆盖 Boot BOM 的 42.7.11——CVE-2026-54291（CVSS 8.2）修复于 42.7.12。 -->
    <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    <postgresql.version>42.7.12</postgresql.version>

    <!-- MCP Java SDK（Plugin Tool 方式二）；锁 1.x 线，2.x 为新主版本待 US4 评估 -->
    <mcp.version>1.1.4</mcp.version>

    <!-- 结构化日志：prod 档 JSON 输出（logstash-logback-encoder 9.x 需 logback 1.5.x） -->
    <logstash-logback.version>9.0</logstash-logback.version>

    <!-- OpenAPI / Swagger UI（2.8.x 为 Boot 3.5 线；3.x 需要 Boot 4）。
         springdoc 自带的 swagger-ui 版本偏旧，覆盖为含 DOMPurify 修补的版本。 -->
    <springdoc.version>2.8.17</springdoc.version>
    <swagger-ui.version>5.32.13</swagger-ui.version>

    <!-- Tomcat 10.1.x 线内安全补丁。Boot 3.5.16 BOM 锁 10.1.55，命中 8-9 月批
         11 条 CVSS≥8 CVE；Boot 3.5 已 EOL（OSS 支持止于 2026-06-30），Tomcat
         补丁需手动跟随：10.1.61 为当前 10.1.x 线最新（10.1.60 亦修复 9 月批）。 -->
    <tomcat.version>10.1.61</tomcat.version>

    <!-- Jackson 3（tools.jackson 新坐标，与 Jackson 2 的 com.fasterxml 并存）。
         logstash-logback-encoder 9.0 传递引入 3.0.1；3.0.x 线无安全 backport
         （CVE-2026-29062 修于 3.1.0、CVE-2026-54512/54513 修于 3.1.4、9 月初批
         修于 3.1.6），显式提升到 3.1.7。 -->
    <jackson3.version>3.1.7</jackson3.version>

    <!-- 架构约束测试：ArchUnit 1.4.x（1.x 线最新）；仅 test scope，
         用于把"结构性纪律"变成 CI 红线（见 sableos-tool 的 ToolSandboxWiringTest）。 -->
    <archunit.version>1.4.1</archunit.version>

    <!-- 开发规范：Google 格式（Spotless）+ 阿里 P3C（PMD 6.x，2.1.1 为兼容线）+ Checkstyle 兜底 -->
    <spotless.version>2.43.0</spotless.version>
    <maven-pmd-plugin.version>3.21.2</maven-pmd-plugin.version>
    <pmd.version>6.55.0</pmd.version>
    <p3c.version>2.1.1</p3c.version>
    <maven-checkstyle-plugin.version>3.5.0</maven-checkstyle-plugin.version>
    <checkstyle.version>10.18.2</checkstyle.version>

    <!-- 代码安全：SpotBugs + Find Security Bugs；OWASP Dependency-Check（依赖层 CVE 扫描） -->
    <spotbugs-maven-plugin.version>4.8.6.4</spotbugs-maven-plugin.version>
    <spotbugs.version>4.8.6</spotbugs.version>
    <findsecbugs.version>1.13.0</findsecbugs.version>
    <dependency-check.version>12.2.2</dependency-check.version>
    <nvd.datafeed.url>https://dependency-check.github.io/DependencyCheck_Builder/nvd_cache/</nvd.datafeed.url>
    <!-- 本地快速构建默认跳过 OWASP（首跑需拉 NVD 缓存）；CI 与发版用 -Dowasp.skip=false 开启 -->
    <owasp.skip>true</owasp.skip>

    <!-- 依赖收敛钉版（与 dependencyManagement 中的覆盖配套，勿单独改一处） -->
    <antlr4-runtime.version>4.13.2</antlr4-runtime.version>
    <swagger-annotations.version>2.2.47</swagger-annotations.version>
    <json-schema-validator.version>3.0.0</json-schema-validator.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring AI BOM：版本统一由 BOM 管理，模块只声明 artifactId -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring AI Alibaba BOM -->
      <dependency>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-bom</artifactId>
        <version>${spring-ai-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 阿里 BOM 未收录 dashscope starter，按同一版本号显式锁定 -->
      <dependency>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        <version>${spring-ai-alibaba.version}</version>
      </dependency>

      <!-- 说明：Spring Data JPA、Flyway、SnakeYAML、PostgreSQL 版本由 Spring Boot BOM
           统一管理（flyway-core 内置 SQLite 支持）；仅下列三方件需显式锁版本。 -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp</artifactId>
        <version>${mcp.version}</version>
      </dependency>
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
        <version>${logstash-logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.webjars</groupId>
        <artifactId>swagger-ui</artifactId>
        <version>${swagger-ui.version}</version>
      </dependency>

      <!-- 依赖收敛（enforcer 只告警不阻断，这里把运行期版本钉死，消除版本漂移）：
           Hibernate 6.6 / Spring Data JPA 需要 antlr4-runtime 4.13.2，Spring AI 传递 4.13.1；
           springdoc 2.8.17 需要 swagger-annotations-jakarta 2.2.47，Spring AI 传递 2.2.38。 -->
      <dependency>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-runtime</artifactId>
        <version>${antlr4-runtime.version}</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations-jakarta</artifactId>
        <version>${swagger-annotations.version}</version>
      </dependency>
      <!-- MCP SDK：Spring AI 1.1.8 经 mcp-json-jackson2 传递 mcp-core 0.18.3 /
           json-schema-validator 2.0.0，与项目直连的 mcp 1.1.4（mcp-core 1.1.4 / validator 3.0.0）
           不一致。以下两个 pin 只是把 Maven 最近优先的既有裁决（1.1.4 / 3.0.0）显式化，运行期版本不变。 -->
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-core</artifactId>
        <version>${mcp.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>

      <!-- Jackson 3 覆盖（见 properties 中 jackson3.version 注释）。annotations
           不在覆盖范围：Jackson 3 复用 com.fasterxml.jackson.core 的 2.x 线，由 Boot BOM 管理。 -->
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson3.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson3.version}</version>
      </dependency>

      <!-- 内部模块 -->
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-boot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!-- SpotBugs 抑制注解（provided，只在编译期）：仅用于对确证的误报做**方法级定点抑制**，
           每处必须写 justification 说明理由与「何时必须撤销」。禁止用它绕过真实缺陷。 -->
      <dependency>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-annotations</artifactId>
        <version>${spotbugs.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- ArchUnit：架构约束测试（test scope）。只做"结构纪律"断言，不参与运行时。 -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 构建环境硬约束：本机曾出现 JDK 8 下静默产出 Java 8 字节码的先例，
             用 enforcer 把 JDK 21 / Maven 版本钉死（fail）；依赖收敛仅告警不阻断。 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>enforce-environment</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <requireJavaVersion>
                    <version>[21,)</version>
                  </requireJavaVersion>
                  <requireMavenVersion>
                    <version>[3.8,)</version>
                  </requireMavenVersion>
                </rules>
              </configuration>
            </execution>
            <execution>
              <id>warn-dependency-convergence</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <dependencyConvergence/>
                </rules>
                <fail>false</fail>
              </configuration>
            </execution>
          </executions>
        </plugin>

        <!-- 格式层：Google 格式，apply 一键自动修（本地写码后 mvn spotless:apply） -->
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <style>GOOGLE</style>
              </googleJavaFormat>
              <removeUnusedImports/>
              <importOrder/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <!-- 快失败：格式检查提前到 compile/test 之前（spotless:check 默认绑 verify） -->
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- 编码规约层：阿里 P3C 挂在 PMD 上（PMD 6.x 是 P3C 2.1.1 唯一兼容线） -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-pmd-plugin</artifactId>
          <version>${maven-pmd-plugin.version}</version>
          <configuration>
            <!-- PMD 6.55 最高只认到 Java 19 语法，按 17 级解析。业务代码避免 Java 18-21
                 的 *语法*（record pattern、pattern switch）；records/sealed 可用。 -->
            <targetJdk>17</targetJdk>
            <printFailingErrors>true</printFailingErrors>
            <skipPmdError>false</skipPmdError>
            <linkXRef>false</linkXRef>
            <analysisCache>true</analysisCache>
            <rulesets>
              <ruleset>rulesets/java/ali-naming.xml</ruleset>
              <ruleset>rulesets/java/ali-oop.xml</ruleset>
              <ruleset>rulesets/java/ali-concurrent.xml</ruleset>
              <ruleset>rulesets/java/ali-exception.xml</ruleset>
              <ruleset>rulesets/java/ali-constant.xml</ruleset>
              <ruleset>rulesets/java/ali-flowcontrol.xml</ruleset>
              <ruleset>rulesets/java/ali-set.xml</ruleset>
              <ruleset>rulesets/java/ali-other.xml</ruleset>
            </rulesets>
          </configuration>
          <dependencies>
            <!-- PMD 6.55 自带 ASM 过旧，类型解析读到 Java 21 字节码（class v65）会抛
                 "Unsupported class file major version 65"；ASM 9.7 认识 v65。 -->
            <dependency>
              <groupId>org.ow2.asm</groupId>
              <artifactId>asm</artifactId>
              <version>9.7</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-core</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>net.sourceforge.pmd</groupId>
              <artifactId>pmd-java</artifactId>
              <version>${pmd.version}</version>
            </dependency>
            <dependency>
              <groupId>com.alibaba.p3c</groupId>
              <artifactId>p3c-pmd</artifactId>
              <version>${p3c.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- 兜底层：Checkstyle（google_checks），只拦 error 级 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>google_checks.xml</configLocation>
            <violationSeverity>error</violationSeverity>
            <failOnViolation>true</failOnViolation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <id>checkstyle-validate</id>
              <phase>validate</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- 安全扫描（字节码层）：SpotBugs + Find Security Bugs（OWASP Top 10 规则） -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Low</threshold>
            <plugins>
              <plugin>
                <groupId>com.h3xstream.findsecbugs</groupId>
                <artifactId>findsecbugs-plugin</artifactId>
                <version>${findsecbugs.version}</version>
              </plugin>
            </plugins>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>com.github.spotbugs</groupId>
              <artifactId>spotbugs</artifactId>
              <version>${spotbugs.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <!-- 安全扫描（依赖层）：OWASP Dependency-Check，CVSS ≥ 8 阻断构建 -->
        <plugin>
          <groupId>org.owasp</groupId>
          <artifactId>dependency-check-maven</artifactId>
          <version>${dependency-check.version}</version>
          <configuration>
            <skip>${owasp.skip}</skip>
            <failBuildOnCVSS>8</failBuildOnCVSS>
            <!-- NVD 夜间缓存镜像：无需 NVD API key（fork PR 同样可跑） -->
            <nvdDatafeedUrl>${nvd.datafeed.url}</nvdDatafeedUrl>
            <!-- 不用 OSS Index（需要凭证）；NVD 与 CISA 保持启用 -->
            <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
            <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
            <formats>
              <format>HTML</format>
              <format>JSON</format>
            </formats>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 集成冒烟（@Tag("integration")）默认不跑：外部 API 可用性不绑架日常构建/CI -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>integration</excludedGroups>
          <!-- Mockito 5 的 inline mock maker 在测试期动态挂载 byte-buddy agent，JDK 21 默认
               打印 4 行「dynamic agent loading」警告（未来 JDK 将直接禁止）。显式开启后只保留
               Mockito 自己打印的 self-attaching 提示（那是 Mockito 的行为，不受此开关影响）。 -->
          <argLine>-XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
