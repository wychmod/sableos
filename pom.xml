<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.sableos</groupId>
  <artifactId>sableos-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SableOS</name>
  <description>企业能完全掌控的、Java 原生的、私有可审计的 Agent OS（Agent Harness OS）</description>

  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <modules>
    <module>sableos-core</module>
    <module>sableos-provider</module>
    <module>sableos-memory</module>
    <module>sableos-tool</module>
    <module>sableos-channel-cli</module>
    <module>sableos-web</module>
    <module>sableos-storage</module>
    <module>sableos-cli</module>
    <module>sableos-boot</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <picocli.version>4.7.7</picocli.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sableos</groupId>
        <artifactId>sableos-boot</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
