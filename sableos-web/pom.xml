<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sableos</groupId>
    <artifactId>sableos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sableos-web</artifactId>
  <name>sableos-web</name>
  <description>核心能力五：WebServer、六个 ApiController、OpenAPI 文档</description>

  <dependencies>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-core</artifactId>
    </dependency>
    <!-- 26 节：GET /api/v1/tools 需要列全部已注册工具（ToolRegistry.all()）。
         tool 只依赖 core，web→tool→core 不成环；其余查询能力走 core 契约，不扩大依赖面。 -->
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 参数校验（缺参 / 格式非法 / 超长 → 400 统一信封） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- OpenAPI / Swagger UI（/swagger-ui.html、/v3/api-docs） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- 仅用于确证误报的方法/类级定点抑制（AGENTS §5.3）：SandboxWhitelistController 的
         EI_EXPOSE_REP2（注入单例）与 SPRING_ENDPOINT（无认证端点属既定前提）。 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
