# 构建产物
target/

# IDE
.idea/
*.iml
.vscode/

# 运行时工作区
.sableos/

# 本地工具目录
.qoder-credits/

# Qoder IDE 本地状态不入库（可能含 memory/logs/settings 等本机数据），
# 只保留 Spec Kit 生成的技能目录；必须是 .qoder/* 再反选，
# 直接写 .qoder/ 会让 git 不再进入该目录，! 反选失效
.qoder/*
!.qoder/skills/

# AI coding agent 本地工作状态（含本地记忆，不入库）
.workbuddy/

# 评审截图：由 website/ 的 HTML 按需重新生成即可，不入库
# 重新生成方式见 design/README.md「质量校验」一节
design/preview/*.png

# 操作系统
.DS_Store
Thumbs.db

# 字体构建中间产物
design/assets/_fontcache/
