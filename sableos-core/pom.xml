<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sableos</groupId>
    <artifactId>sableos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sableos-core</artifactId>
  <name>sableos-core</name>
  <description>核心抽象与接口：SableTool、Session、Profile、ContextLoader、ReActLoop、PromptBuilder、ToolExecutor、AgentService、AgentScheduler 等</description>
  <dependencies>
    <!-- 链路标识（com.sableos.core.trace）只需日志门面：core 保持框架无关，
         版本由父 POM 的 Spring Boot BOM 管理，勿在此写 <version> -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- 仅供 TraceIds 上那处带理由的 SpotBugs 定点抑制使用，编译期依赖 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- AGENT.md frontmatter 解析（AgentLoader，只读受信工作区文件） -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <!-- SableTool.execute(JsonNode) 入参类型；版本由父 POM 的 Spring Boot BOM 管理 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
