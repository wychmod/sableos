<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sableos</groupId>
    <artifactId>sableos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sableos-boot</artifactId>
  <name>sableos-boot</name>
  <description>Spring Boot 启动模块：主类、自动配置、依赖聚合</description>

  <dependencies>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-channel-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-cli</artifactId>
    </dependency>

    <!-- Observability：Actuator + Micrometer/Prometheus -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 结构化日志（prod 档 JSON 输出，见 logback-spring.xml） -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
    </dependency>

    <!-- 架构约束测试（test scope，版本由父 POM 锁定）：boot 是唯一依赖全部模块的汇编模块，
         只有在这里才能观察到跨模块依赖方向（见 ArchitectureTest） -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 18 节：fat JAR 主类 = Picocli 命令行入口（轻命令零 Spring 秒回，重命令自启动 SableOsRuntime）。
               boot 仍是 fat JAR 的产出方（AGENTS.md 口径不变），只是入口从 SableOsApplication 换成 SableOsCli。 -->
          <mainClass>com.sableos.cli.SableOsCli</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
