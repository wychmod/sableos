<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sableos</groupId>
    <artifactId>sableos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sableos-tool</artifactId>
  <name>sableos-tool</name>
  <description>核心能力四：内置 Tool、MCP Client、ToolRegistry、Sandbox 与通知适配器（三合一模块）</description>

  <dependencies>
    <dependency>
      <groupId>com.sableos</groupId>
      <artifactId>sableos-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- @Tool / @ToolParam 注解与 ToolCallbacks（注解管道三要素与 schema 生成；禁用自动执行仅用适配层） -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <!-- MCP 客户端（聚合 mcp-core + mcp-json-jackson3；版本由父 POM 显式锁定） -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
    </dependency>
    <!-- mcp_servers.yaml 解析（Boot BOM 管理版本，非新第三方） -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <!-- 仅供 WebhookNotifyAdapter 构造器上那处带理由的 SpotBugs 定点抑制使用，编译期依赖 -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @ConfigurationProperties 注解（24 节 sandbox 三个白名单属性记录），版本由 Boot BOM 管理 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
  </dependencies>
</project>
